{
 "note": "CY 日文課的練習題庫。課次大致對應《大家學標準日本語》初級本，但單字、例句、說明都是自己寫的。漢字[讀音] 會顯示成上方小字；blank 是填空要挖掉的部分，opts 是錯的選項。",
 "lessons": [
  {
   "no": 1,
   "title": "自我介紹：是／不是／是嗎",
   "goals": [
    {
     "no": 1,
     "title": "名詞肯定句",
     "pattern": "A は B です。",
     "explain": "「は」當助詞時念 wa，標出這句話的主題（在說誰、說什麼）。「です」放在句尾＝中文的「是」，而且是禮貌的說法。"
    },
    {
     "no": 2,
     "title": "名詞否定句",
     "pattern": "A は B じゃ ありません。",
     "explain": "把「です」換成「じゃ ありません」就是「不是」。比較正式的寫法是「では ありません」（這裡的 は 也念 wa）。"
    },
    {
     "no": 3,
     "title": "名詞疑問句",
     "pattern": "A は B ですか。",
     "explain": "句尾加「か」就變成問句，語調上揚。回答：「はい、そうです」（是的）／「いいえ、ちがいます」（不是）。"
    },
    {
     "no": 4,
     "title": "助詞「の」",
     "pattern": "A の B",
     "explain": "「の」把兩個名詞接起來＝「的」：所屬（わたしの 名前）、身分（東京大学の 学生）、內容（日本語の 先生）。"
    }
   ],
