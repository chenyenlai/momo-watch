   "goals": [
    {
     "no": 12,
     "title": "助詞「へ」（往哪裡去）",
     "pattern": "場所 へ 行[い]きます。",
     "explain": "「へ」表示移動的方向，當助詞念 e（不念 he）。常用動詞：行きます（去）、来ます（來）、帰ります（回家、回去）。口語也常用「に」代替「へ」，意思一樣。"
    },
    {
     "no": 13,
     "title": "助詞「で」②（搭什麼去）",
     "pattern": "交通工具 で 行[い]きます。",
     "explain": "「で」除了第 3 課的「在哪裡做」，也表示「用什麼方法」：電車で（搭電車）。走路不用で，直接說「歩いて 行きます」。問怎麼去：「何で 行きますか」（何で 念 なんで）。"
    },
    {
     "no": 14,
     "title": "へ 和 で 一起用",
     "pattern": "時間 ＋ 人と ＋ 工具で ＋ 場所へ 行[い]きます。",
     "explain": "把學過的助詞組起來：明日 友達と 電車で 京都へ 行きます。名詞的順序可以換，但每個名詞後面的助詞要跟著走，所以看懂助詞比背順序重要。"
    }
   ],
