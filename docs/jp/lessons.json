   "title": "約人：要不要一起～？",
   "goals": [
    {
     "no": 8,
     "title": "助詞「と」（和、跟）",
     "pattern": "人 と ～ます。",
     "explain": "「と」表示一起做事的人：友達と 食べます（和朋友吃）。句子裡的「を」標出動作的對象（吃「什麼」），第 5 課會再細講。"
    },
    {
     "no": 9,
     "title": "邀請：～ませんか／～ましょう",
     "pattern": "いっしょに ～ませんか。",
     "explain": "動詞的「ます」換成「ませんか」＝禮貌地問「要不要～？」。答應：「いいですね。～ましょう」（好啊，～吧）。拒絕時日本人常只說「ちょっと…」（有點…），不把話說完。"
    },
    {
     "no": 10,
     "title": "助詞「に」（時間點）",
     "pattern": "時間 に ～ます。",
     "explain": "有數字的時間後面加「に」：7時に、土曜日に。「今日、明日、毎日」這類相對時間不加「に」。注意讀音：4時 よじ、7時 しちじ、9時 くじ。"
    },
    {
     "no": 11,
     "title": "助詞「で」（在哪裡做）",
     "pattern": "地點 で ～ます。",
     "explain": "「で」表示動作在哪裡進行：駅で 会います（在車站見面）。第 4 課會學到「で」的另一個用法（搭什麼交通工具）。"
    }
   ],
