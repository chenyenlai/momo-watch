   "goals": [
    {
     "no": 5,
     "title": "指地方：ここ・そこ・あそこ・どこ",
     "pattern": "～は どこですか。",
     "explain": "ここ＝我這邊、そこ＝你那邊、あそこ＝離我們都遠的地方、どこ＝哪裡。旅行問路最常用：「トイレは どこですか」。"
    },
    {
     "no": 6,
     "title": "指東西：これ・それ・あれ・どれ",
     "pattern": "これは ～です。",
     "explain": "單獨當名詞用：これ（我這邊的東西）、それ（你那邊的）、あれ（遠處的）、どれ（哪一個）。買東西指著說「これを ください」＝請給我這個。"
    },
    {
     "no": 7,
     "title": "この・その・あの・どの ＋ 名詞",
     "pattern": "この ～は いくらですか。",
     "explain": "後面一定接名詞：この 時計（這支錶）。比較：「これは 時計です」（這是錶）／「この 時計は いくらですか」（這支錶多少錢）。どれ 單獨用，どの 後面接名詞。"
    }
   ],
